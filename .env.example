# Server Configuration
PORT=4000

# AI Provider Configuration
# Set USE_OPENROUTER to 'true' to use OpenRouter, or 'false'/'undefined' to use OpenAI directly
USE_OPENROUTER=true

# OpenRouter Configuration (if USE_OPENROUTER=true)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional: Your site URL and name for OpenRouter rankings
YOUR_SITE_URL=http://localhost:4000
YOUR_SITE_NAME=AI Scenarios Generator

# OpenAI Configuration (if USE_OPENROUTER=false or not set)
OPENAI_API_KEY=your-openai-api-key-here

# Model Configuration
# For OpenRouter, use format: provider/model-name (e.g., 'openai/gpt-4o-mini', 'anthropic/claude-3-sonnet')
# For OpenAI direct, use: 'gpt-4o-mini', 'gpt-4o', etc.
# See available models at https://openrouter.ai/models
AI_MODEL=openai/gpt-4o-mini

# Legacy (kept for backwards compatibility, use AI_MODEL instead)
MODEL_NAME=llama3.1:latest
OPENAI_MODEL=gpt-4o-mini
API_URL=http://localhost:11434/api/generate
