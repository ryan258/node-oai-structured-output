# API Configuration
# Set USE_OPENROUTER=true to use OpenRouter, false to use OpenAI directly
USE_OPENROUTER=true

# OpenRouter API Key (required if USE_OPENROUTER=true)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (required if USE_OPENROUTER=false)
OPENAI_API_KEY=your_openai_api_key_here

# AI Model to use (OpenRouter format: provider/model)
AI_MODEL=openai/gpt-4o-mini

# Server Configuration
PORT=4000

# OpenRouter Site Information (for rankings/attribution)
YOUR_SITE_URL=http://localhost:4000
YOUR_SITE_NAME=AI Scenarios Generator

# Security Configuration
# IMPORTANT: Change this to a secure random string in production
ADMIN_API_KEY=change_me_to_a_secure_key

# CORS Origin - restrict to specific domains in production
# Use comma-separated values for multiple origins
# Example: http://localhost:3000,https://myapp.com
CORS_ORIGIN=http://localhost:4000

# Demo Mode (optional)
# Set to 'true' to enable continuous demo mode with predefined topics
# DEMO_MODE=true

# Environment
# NODE_ENV=development
